def ask_text(p): return input(p)
def ask_int(p): return int(input(p))

def build_bio(n,a,c,l,y):
    return f"{'='*40}\n{'ABOUT ME':^40}\n{'='*40}\nName:      {n}\nAge:       {a}\nCity:      {c}\nCodes in:  {l}\nCoding for {y} years.\n{'='*27}"

def main():
    n=ask_text("What is your name? ")
    a=ask_int("How old are you? ")
    c=ask_text("Which city are you from? ")
    l=ask_text("Favourite programming language? ")
    y=ask_int("How many years have you been coding? ")
    print("\n"+build_bio(n,a,c,l,y))

if __name__=="__main__": 
    main()

